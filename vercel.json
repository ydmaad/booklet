{
  "functions": {
    "backend/api/**/*.ts": { "runtime": "nodejs20.x" }
  },
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/api/$1.ts" },
    { "src": "/(.*)", "dest": "/frontend/dist/$1" }
  ]
}
